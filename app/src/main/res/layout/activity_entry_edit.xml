<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!--text box for investigation's title-->
    <EditText
        android:id="@+id/etEditTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Title:"
        android:inputType="textCapWords"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--text box for investigation location-->
    <EditText
        android:id="@+id/etEditLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Location:"
        android:inputType="textCapWords"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etEditTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--date/time picker-->
    <EditText
        android:id="@+id/etEditDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:hint="Date/Time:"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etEditLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvEditEquipmentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Equipment Used:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etEditDateTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:id="@+id/svEditEquipment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvEditEquipmentLabel"
        app:layout_constraintBottom_toTopOf="@id/etEditNotes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llEditEquipLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbEditEmfReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMF Reader"/>

            <CheckBox
                android:id="@+id/cbEditRemPod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REM Pod"/>

            <CheckBox
                android:id="@+id/cbEditSpiritBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Box"/>

            <CheckBox
                android:id="@+id/cbEditEvpRecorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EVP Recorder"/>

            <CheckBox
                android:id="@+id/cbEditThermometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thermometer"/>

            <CheckBox
                android:id="@+id/cbEditAudioRecorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio Recorder"/>

            <CheckBox
                android:id="@+id/cbEditCatBall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motion Sensing Cat Balls"/>

            <CheckBox
                android:id="@+id/cbEditThermalImager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thermal Imager"/>

        </LinearLayout>

    </ScrollView>

    <!--text box for notes-->
    <EditText
        android:id="@+id/etEditNotes"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:hint="Notes:"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/llButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Delete Entry"
            android:backgroundTint="#F44336"/>

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Save Changes"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
