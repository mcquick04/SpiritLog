<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!--text box for investigation's title-->
    <EditText
        android:id="@+id/etTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Title:"
        android:inputType="textCapWords"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--text box for investigation location-->
    <EditText
        android:id="@+id/etLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Location:"
        android:inputType="textCapWords"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--date/time picker-->
    <EditText
        android:id="@+id/etDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:hint="Date/Time:"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--equipment label (outside ScrollView) -->
    <TextView
        android:id="@+id/tvEquipmentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Equipment Used:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etDateTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:id="@+id/svEquipment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvEquipmentLabel"
        app:layout_constraintBottom_toTopOf="@id/tvEvidenceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llEquipLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox android:id="@+id/cbEmfReader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EMF Reader"/>
            <CheckBox android:id="@+id/cbRemPod" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="REM Pod"/>
            <CheckBox android:id="@+id/cbSpiritBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spirit Box"/>
            <CheckBox android:id="@+id/cbEvpRecorder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EVP Recorder"/>
            <CheckBox android:id="@+id/cbThermometer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thermometer"/>
            <CheckBox android:id="@+id/cbAudioRecorder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Audio Recorder"/>
            <CheckBox android:id="@+id/cbCatBall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Motion Sensing Cat Balls"/>
            <CheckBox android:id="@+id/cbThermalImager" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thermal Imager"/>

        </LinearLayout>

    </ScrollView>

    <!--evidence section -->
    <TextView
        android:id="@+id/tvEvidenceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Evidence &amp; Media:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/svEquipment"
        app:layout_constraintBottom_toTopOf="@id/etEvidenceUrl"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etEvidenceUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Evidence URL (e.g. YouTube):"
        android:inputType="textUri"
        app:layout_constraintTop_toBottomOf="@id/tvEvidenceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llMediaButtons"/>

    <LinearLayout
        android:id="@+id/llMediaButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etEvidenceUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etNotes">

        <Button android:id="@+id/btnAddImage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Picture" android:textSize="12sp"/>
        <Button android:id="@+id/btnAddVideo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Video" android:textSize="12sp" android:layout_marginHorizontal="4dp"/>
        <Button android:id="@+id/btnAddAudio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Audio" android:textSize="12sp"/>
    </LinearLayout>

    <!--text box for notes-->
    <EditText
        android:id="@+id/etNotes"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:hint="Notes:"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/llMediaButtons"
        app:layout_constraintBottom_toTopOf="@id/btnNewEntry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--save entry button-->
    <Button
        android:id="@+id/btnNewEntry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save Entry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ProgressBar for saving status -->
    <ProgressBar
        android:id="@+id/pbSaving"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
