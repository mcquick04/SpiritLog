<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!--text box for investigation's title-->
    <EditText
        android:id="@+id/etTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Title:"
        android:inputType="textCapWords"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--text box for investigation location-->
    <EditText
        android:id="@+id/etLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Location:"
        android:inputType="textCapWords"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--date/time picker-->
    <EditText
        android:id="@+id/etDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:hint="Date/Time:"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Equipment Label (Outside ScrollView) -->
    <TextView
        android:id="@+id/tvEquipmentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Equipment Used:"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etDateTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:id="@+id/svEquipment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvEquipmentLabel"
        app:layout_constraintBottom_toTopOf="@id/etNotes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llEquipLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbEmfReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EMF Reader"/>

            <CheckBox
                android:id="@+id/cbRemPod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REM Pod"/>

            <CheckBox
                android:id="@+id/cbSpiritBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spirit Box"/>

            <CheckBox
                android:id="@+id/cbEvpRecorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EVP Recorder"/>

            <CheckBox
                android:id="@+id/cbThermometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thermometer"/>

            <CheckBox
                android:id="@+id/cbAudioRecorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio Recorder"/>

            <CheckBox
                android:id="@+id/cbCatBall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motion Sensing Cat Balls"/>

            <CheckBox
                android:id="@+id/cbThermalImager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thermal Imager"/>

        </LinearLayout>

    </ScrollView>

    <!--text box for notes-->
    <EditText
        android:id="@+id/etNotes"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:hint="Notes:"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnNewEntry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--save entry button-->
    <Button
        android:id="@+id/btnNewEntry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Save Entry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
